<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>

  <!-- 顶部：站点头部 -->
  <%- include('../partials/header') %>

  <!-- 主内容：分类下的车辆列表 -->
  <main class="main-content">
    <h1><%= title %></h1>

    <!-- Flash messages (统一使用 messages 数组) -->
    <% if (messages && messages.length > 0) { %>
      <div class="notice">
        <% messages.forEach(msg => { %>
          <p><%= msg %></p>
        <% }) %>
      </div>
    <% } %>

    <!-- 由 utilities.buildClassificationGrid() 生成的内容 -->
    <%- grid %>
  </main>

  <!-- 页脚 -->
  <%- include('../partials/footer') %>

</body>
</html>
