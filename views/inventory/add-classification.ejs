<%- nav %>

<main class="form-wrapper">

  <h1>Add Classification</h1>

  <!-- Flash notice -->
  <% if (messages && messages.length > 0) { %>
    <div class="notice">
      <% messages.forEach(msg => { %>
        <p><%= msg %></p>
      <% }) %>
    </div>
  <% } %>

  <!-- Server-side errors -->
  <% if (errors && errors.length > 0) { %>
    <ul class="errors">
      <% errors.forEach(err => { %>
        <li><%= err.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/inv/add-classification" method="post">

    <label for="classification_name">
      Classification Name (letters & numbers only, no spaces)
      <span class="required">*</span>
    </label>

    <input
      id="classification_name"
      name="classification_name"
      type="text"
      required
      pattern="^[A-Za-z0-9]+$"
      title="Letters and numbers only. No spaces or symbols."
      value="<%= classification_name %>"
    />

    <button type="submit" class="submit-btn">Add Classification</button>
  </form>

</main>

<style>
  .form-wrapper {
    max-width: 600px;
    margin: auto;
    padding: 1rem;
  }

  .errors {
    padding: 10px;
    background: #ffe6e6;
    border-left: 5px solid red;
  }

  .notice {
    padding: 10px;
    background: #e6ffe6;
    border-left: 5px solid green;
  }

  .required {
    color: red;
  }

  input:invalid {
    border-left: 4px solid red;
  }

  input:valid {
    border-left: 4px solid green;
  }

  .submit-btn {
    margin-top: 1rem;
    padding: 8px;
    font-size: 1.1rem;
  }
</style>
