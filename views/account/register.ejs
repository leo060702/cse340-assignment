<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <!-- 顶部：站点头部 + 导航 -->
  <%- include('../partials/header') %>

  <main class="main-content">
    <h1>Account Registration</h1>

    <!-- Flash 提示信息 -->
    <% if (messages && messages.length > 0) { %>
      <div class="notice">
        <% messages.forEach(msg => { %>
          <p><%= msg %></p>
        <% }) %>
      </div>
    <% } %>

    <!-- 表单验证错误 -->
    <% if (errors && errors.length > 0) { %>
      <div class="error-list">
        <ul>
          <% errors.forEach(err => { %>
            <li><%= err.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/account/register" method="post" class="account-form">
      <div class="form-group">
        <label for="account_firstname">First Name</label>
        <input
          type="text"
          id="account_firstname"
          name="account_firstname"
          required
          value="<%= typeof account_firstname !== 'undefined' ? account_firstname : '' %>"
        />
      </div>

      <div class="form-group">
        <label for="account_lastname">Last Name</label>
        <input
          type="text"
          id="account_lastname"
          name="account_lastname"
          required
          value="<%= typeof account_lastname !== 'undefined' ? account_lastname : '' %>"
        />
      </div>

      <div class="form-group">
        <label for="account_email">Email</label>
        <input
          type="email"
          id="account_email"
          name="account_email"
          required
          value="<%= typeof account_email !== 'undefined' ? account_email : '' %>"
        />
      </div>

      <div class="form-group">
        <label for="account_password">Password</label>
        <input
          type="password"
          id="account_password"
          name="account_password"
          required
        />
      </div>

      <button type="submit" class="button">Register</button>
    </form>

    <p>
      Already have an account?
      <a href="/account/login">Log in here</a>.
    </p>
  </main>

  <!-- 页脚 -->
  <%- include('../partials/footer') %>
</body>
</html>
