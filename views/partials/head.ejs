<header>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CSE Motors</title>
  <link rel="stylesheet" href="/css/styles.css" media="screen">

  <div id="top-header">
    <div class="siteName">
      <a href="/">CSE Motors</a>
    </div>

    <div id="tools">
      <!-- 登录状态判断：未登录显示 My Account，已登录显示 Welcome + Logout -->
      <% if (locals.loggedin) { %>
        <a href="/account/">Welcome <%= locals.accountData.account_firstname %></a>
        <a href="/account/logout" class="logout-link">Logout</a>
      <% } else { %>
        <a href="/account/login">My Account</a>
      <% } %>
    </div>
  </div>

  <!-- 主导航栏 -->
  <nav>
    <%- nav %>
  </nav>
</header>
