<header>
  <!-- 顶部区域：左右留空间，中间标题自动居中 -->
  <div id="top-header" style="
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 20px;
  ">
    <!-- 左侧占位（保持标题真正居中） -->
    <div class="left-placeholder" style="width: 120px;"></div>

    <!-- 中间标题：居中显示 -->
    <div class="siteName" style="
        flex-grow: 1;
        text-align: center;
        font-size: 1.6rem;
        font-weight: bold;
    ">
      <a href="/" style="text-decoration: none; color: inherit;">CSE Motors</a>
    </div>

    <!-- 右侧工具栏 -->
    <div id="tools" style="width: 120px; text-align: right;">
      <% if (locals.loggedin) { %>
        <a href="/account/">Welcome <%= locals.accountData.account_firstname %></a>
        <a href="/account/logout" class="logout-link">Logout</a>
      <% } else { %>
        <a href="/account/login" title="Click to log in">My Account</a>
      <% } %>
    </div>
  </div>

  <!-- 主导航栏 -->
  <nav>
    <%- nav %>
  </nav>
</header>
